PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Auto-triage: "llm" calls the local model, "rules" uses the offline keyword engine
TRIAGE_MODE=llm
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Per-triage-call timeout. A warm qwen2.5:7b triage call takes ~12-15s on
# modest hardware; the server also warms the model on startup. Triage-only.
OLLAMA_TIMEOUT_MS=20000

# Optional cloud fallback — used ONLY when the local model fails/times out.
# Any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Gemini's OpenAI endpoint).
# Leave FALLBACK_API_KEY empty to stay fully local (rules engine is the last resort).
FALLBACK_API_KEY=
FALLBACK_API_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4o-mini
